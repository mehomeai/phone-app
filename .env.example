# Live integration runner configuration (optional).
# Copy to .env (gitignored) or export directly. Fixture tests need none of this.
# No real tokens live in this repo; fixtures use synthetic `fixture-...` secrets.
# Device credentials are issued by the home at pair time, never configured here.

# Home service base URL. Loopback http is allowed for local runs.
ME_HOME_BASE_URL=http://127.0.0.1:7070

# Two one-time invitations as JSON: {"invitationId":"...","pairingSecret":"...","expectedUserId":"..."}
# Create with: node src/cli.mjs bootstrap --user=<alice|bob> --db=<path>  (in infra-server)
ME_HOME_INVITE_A=
ME_HOME_INVITE_B=

# Optional: expected installation id (verifies wrong_home detection).
ME_HOME_INSTALLATION=

# Optional: hosted backend coordination check (B1 interface pending).
ME_BACKEND_BASE_URL=

# Optional override of the H1 contract file path.
H1_CONTRACT_PATH=
