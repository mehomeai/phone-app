{
  "name": "@mehomeai/mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Me phone frontend: Expo conversation/task/household experience paired with the home service. Imported from the user-provided me-mobile prototype; preserves its screens, navigation, Feed/Chat/Me and demo behavior.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:clip-sources": "node --test tests/check-clip-sources.test.cjs",
    "test:web": "expo export --platform web --output-dir .expo-web-dist && PORT=4173 node scripts/serve-web-dist.cjs",
    "test:ui": "playwright test --config playwright.config.js",
    "build:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "~58.0.16",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.1",
    "expo-file-system": "~58.0.13",
    "expo-notifications": "~58.0.11",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@playwright/test": "^1.64.1",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "@ungap/structured-clone": "^1.3.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
